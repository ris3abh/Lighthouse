{
  "$defs": {
    "ChannelConfig": {
      "additionalProperties": false,
      "description": "One notification channel. Secrets (webhook URLs, SMTP password, ntfy token) live in the keychain\nunder ``secret_ref``; this file only names the entry.",
      "properties": {
        "detail": {
          "default": "full",
          "description": "minimal sends counts only (no titles), for channels that leave this machine.",
          "enum": [
            "full",
            "minimal"
          ],
          "title": "Detail",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "from_addr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Addr"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "kind": {
          "enum": [
            "desktop",
            "email",
            "slack",
            "discord",
            "ntfy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "port": {
          "default": 587,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "secret_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keychain entry: webhook URL, SMTP password or ntfy token.",
          "title": "Secret Ref"
        },
        "server": {
          "default": "https://ntfy.sh",
          "title": "Server",
          "type": "string"
        },
        "starttls": {
          "default": true,
          "title": "Starttls",
          "type": "boolean"
        },
        "to_addr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Addr"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ChannelConfig",
      "type": "object"
    },
    "ConnectorConfig": {
      "additionalProperties": false,
      "properties": {
        "include_forks": {
          "default": false,
          "title": "Include Forks",
          "type": "boolean"
        },
        "min_downloads_for_candidate": {
          "default": 100,
          "minimum": 0,
          "title": "Min Downloads For Candidate",
          "type": "integer"
        },
        "min_stars_for_candidate": {
          "default": 5,
          "minimum": 0,
          "title": "Min Stars For Candidate",
          "type": "integer"
        }
      },
      "title": "ConnectorConfig",
      "type": "object"
    },
    "NotificationsConfig": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "additionalProperties": {
            "$ref": "#/$defs/ChannelConfig"
          },
          "description": "Named channels. Desktop is on by default; add email / slack / discord / ntfy as needed.",
          "title": "Channels",
          "type": "object"
        },
        "deadline_alert_days": {
          "description": "Alert when a deadline is this many days away.",
          "items": {
            "type": "integer"
          },
          "title": "Deadline Alert Days",
          "type": "array"
        },
        "routes": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Which channels each event goes to.",
          "propertyNames": {
            "enum": [
              "deadline",
              "digest",
              "new_candidates",
              "sync_error",
              "test"
            ]
          },
          "title": "Routes",
          "type": "object"
        }
      },
      "title": "NotificationsConfig",
      "type": "object"
    },
    "PrivacyConfig": {
      "additionalProperties": false,
      "properties": {
        "redact_before_llm": {
          "default": true,
          "title": "Redact Before Llm",
          "type": "boolean"
        }
      },
      "title": "PrivacyConfig",
      "type": "object"
    },
    "ServerConfig": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "const": "127.0.0.1",
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 7777,
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        }
      },
      "title": "ServerConfig",
      "type": "object"
    }
  },
  "$id": "https://lighthouse-gc.dev/schemas/v1/lighthouse-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connectors": {
      "$ref": "#/$defs/ConnectorConfig"
    },
    "engine": {
      "default": "claude_code",
      "enum": [
        "claude_code",
        "codex",
        "api"
      ],
      "title": "Engine",
      "type": "string"
    },
    "notifications": {
      "$ref": "#/$defs/NotificationsConfig"
    },
    "overrides": {
      "additionalProperties": {
        "additionalProperties": {
          "enum": [
            "dropped",
            "gap"
          ],
          "type": "string"
        },
        "type": "object"
      },
      "description": "User status overrides per profile: {profile_id: {criterion_id: dropped|gap}}.",
      "title": "Overrides",
      "type": "object"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyConfig"
    },
    "profile": {
      "default": "",
      "description": "Active profile id; the domain layer supplies the default.",
      "title": "Profile",
      "type": "string"
    },
    "schedules": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Cron expressions per job. Used by the scheduler (Phase 1) and as cron hints.",
      "title": "Schedules",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "server": {
      "$ref": "#/$defs/ServerConfig"
    },
    "workspace_name": {
      "default": "my-case",
      "title": "Workspace Name",
      "type": "string"
    }
  },
  "title": "WorkspaceConfig",
  "type": "object"
}
