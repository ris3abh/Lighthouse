{
  "$defs": {
    "Exhibit": {
      "additionalProperties": false,
      "properties": {
        "accepted_at": {
          "format": "date-time",
          "title": "Accepted At",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "claim_ids": {
          "description": "Approved memory claims this exhibit cites.",
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "criterion": {
          "title": "Criterion",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "file": {
          "description": "Path relative to the workspace: evidence/<crit>/<crit>_<yyyy-mm-dd>_<slug>.<ext>",
          "title": "File",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fingerprint of the accepted candidate, for de-duplication.",
          "title": "Fingerprint"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "invited",
                "accepted",
                "completed",
                "declined",
                "cancelled",
                "preprint",
                "submitted",
                "published",
                "retracted",
                "applied",
                "granted",
                "denied"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only completed stages (or None) count toward a criterion.",
          "title": "Stage"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "evidence_type",
        "title",
        "date",
        "file"
      ],
      "title": "Exhibit",
      "type": "object"
    }
  },
  "$id": "https://lighthouse-gc.dev/schemas/v1/exhibits.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exhibits": {
      "items": {
        "$ref": "#/$defs/Exhibit"
      },
      "title": "Exhibits",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "Exhibits",
  "type": "object"
}
