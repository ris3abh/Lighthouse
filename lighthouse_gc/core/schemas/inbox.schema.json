{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Numbers at capture time.",
          "title": "Facts",
          "type": "object"
        },
        "fingerprint": {
          "description": "Stable de-duplication key; re-imports never duplicate a candidate.",
          "title": "Fingerprint",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "proposed_criterion": {
          "title": "Proposed Criterion",
          "type": "string"
        },
        "raw_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Url"
        },
        "signals": {
          "description": "Strength signal ids the source observed.",
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "snoozed_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snoozed Until"
        },
        "source": {
          "description": "Source record id that produced this candidate (or 'manual').",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "snoozed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "description": "One-line summary shown in the Inbox.",
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "source",
        "evidence_type",
        "proposed_criterion",
        "title",
        "summary"
      ],
      "title": "Candidate",
      "type": "object"
    }
  },
  "$id": "https://lighthouse-gc.dev/schemas/v1/inbox.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "Inbox",
  "type": "object"
}
