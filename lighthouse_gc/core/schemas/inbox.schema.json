{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observation id of an uploaded file filed on accept.",
          "title": "Attachment"
        },
        "claim_ids": {
          "description": "Memory claims this candidate rests on.",
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Numbers at capture time.",
          "title": "Facts",
          "type": "object"
        },
        "fingerprint": {
          "description": "Stable de-duplication key; re-imports never duplicate a candidate.",
          "title": "Fingerprint",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "kind": {
          "default": "evidence",
          "description": "evidence becomes an exhibit; pipeline / deadline / letter add tracker entries; update changes an existing tracker entry; metric records a metric value; context (from an AI tool over MCP) is kept as a self-reported note. Only evidence can ever become an exhibit.",
          "enum": [
            "evidence",
            "pipeline",
            "deadline",
            "letter",
            "update",
            "metric",
            "context"
          ],
          "title": "Kind",
          "type": "string"
        },
        "proposal": {
          "additionalProperties": true,
          "description": "For tracker candidates: the pipeline / deadline / letter entry to add.",
          "title": "Proposal",
          "type": "object"
        },
        "proposed_criterion": {
          "title": "Proposed Criterion",
          "type": "string"
        },
        "raw_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Url"
        },
        "rule_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule claims in agent-written text, checked."
        },
        "signals": {
          "description": "Strength signal ids the source observed.",
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "snoozed_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snoozed Until"
        },
        "source": {
          "description": "Source record id that produced this candidate (or 'manual').",
          "title": "Source",
          "type": "string"
        },
        "source_tier": {
          "anyOf": [
            {
              "enum": [
                "tier1",
                "tier2",
                "tier3",
                "platform",
                "user",
                "self_reported"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tier of the source this candidate came from.",
          "title": "Source Tier"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "invited",
                "accepted",
                "completed",
                "declined",
                "cancelled",
                "preprint",
                "submitted",
                "published",
                "retracted",
                "applied",
                "granted",
                "denied"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event stage the evidence shows; None if not an activity.",
          "title": "Stage"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "snoozed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "description": "One-line summary shown in the Inbox.",
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "source",
        "evidence_type",
        "proposed_criterion",
        "title",
        "summary"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "RuleCheck": {
      "additionalProperties": false,
      "description": "Rule claims found in a piece of agent-written text and how each was verified (SPEC 5a).",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/RuleClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why nothing was checked, or why checking failed.",
          "title": "Note"
        }
      },
      "title": "RuleCheck",
      "type": "object"
    },
    "RuleCitation": {
      "additionalProperties": false,
      "description": "A knowledge-store excerpt a rule claim was checked against, with the exact words quoted from it.",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "fresh": {
          "default": true,
          "title": "Fresh",
          "type": "boolean"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "secondary_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for a secondary copy: the primary source's id. The primary governs.",
          "title": "Secondary To"
        },
        "sha256": {
          "description": "The snapshot the quote is from.",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Offset of the quote in the source snapshot.",
          "title": "Start",
          "type": "integer"
        },
        "tier": {
          "title": "Tier",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "entails",
            "contradicts"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "source_id",
        "title",
        "tier",
        "url",
        "quote",
        "start",
        "end",
        "sha256",
        "checked_at",
        "verdict"
      ],
      "title": "RuleCitation",
      "type": "object"
    },
    "RuleClaim": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/RuleCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "end": {
          "default": 0,
          "title": "End",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "sentence": {
          "description": "The sentence it came from.",
          "title": "Sentence",
          "type": "string"
        },
        "start": {
          "default": 0,
          "description": "Offset of the sentence in the checked text.",
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "enum": [
            "verified",
            "unverified",
            "stale",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "description": "The rule as the checker restated it.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "sentence",
        "status"
      ],
      "title": "RuleClaim",
      "type": "object"
    }
  },
  "$id": "https://lighthouse-gc.dev/schemas/v1/inbox.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "Inbox",
  "type": "object"
}
