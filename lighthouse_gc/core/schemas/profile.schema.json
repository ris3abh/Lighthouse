{
  "$defs": {
    "CriterionRule": {
      "additionalProperties": false,
      "properties": {
        "min_exhibits": {
          "default": 1,
          "description": "Accepted exhibits needed to bank the criterion.",
          "minimum": 1,
          "title": "Min Exhibits",
          "type": "integer"
        },
        "min_signals": {
          "default": 0,
          "description": "Distinct strength signals needed to bank it.",
          "minimum": 0,
          "title": "Min Signals",
          "type": "integer"
        }
      },
      "title": "CriterionRule",
      "type": "object"
    },
    "NarrativeLayer": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "prompts": {
          "items": {
            "type": "string"
          },
          "title": "Prompts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "NarrativeLayer",
      "type": "object"
    },
    "ProfileCriterion": {
      "additionalProperties": false,
      "properties": {
        "bank": {
          "$ref": "#/$defs/CriterionRule"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "evidence_types": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Evidence Types",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "regulation": {
          "default": "",
          "title": "Regulation",
          "type": "string"
        },
        "short_label": {
          "default": "",
          "description": "One or two words for tight places (\"Awards\"); falls back to label.",
          "title": "Short Label",
          "type": "string"
        },
        "strength_signals": {
          "items": {
            "$ref": "#/$defs/StrengthSignal"
          },
          "title": "Strength Signals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "evidence_types"
      ],
      "title": "ProfileCriterion",
      "type": "object"
    },
    "StrengthSignal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "StrengthSignal",
      "type": "object"
    }
  },
  "$id": "https://lighthouse-gc.dev/schemas/v1/profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "items": {
        "$ref": "#/$defs/ProfileCriterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "narrative": {
      "description": "Qualitative layers scored by the agent, e.g. EB-1A final merits.",
      "items": {
        "$ref": "#/$defs/NarrativeLayer"
      },
      "title": "Narrative",
      "type": "array"
    },
    "regulation": {
      "default": "",
      "title": "Regulation",
      "type": "string"
    },
    "target": {
      "minimum": 1,
      "title": "Target",
      "type": "integer"
    },
    "threshold": {
      "minimum": 1,
      "title": "Threshold",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "threshold",
    "target",
    "criteria"
  ],
  "title": "Profile",
  "type": "object"
}
