# Area O1 model tiers (ADR 0009, ADR 0015). Copy to your workspace as .env (it's gitignored there) or set these in
# your environment. Everything is optional: without them Area O1 uses the tier lines in areao1.yaml
# (agent.models), and those default to the values shown.

# hard: chat, tasks you start, anything written for the petition
AREAO1_MODEL_HARD=gpt-6.1-sol
# mid: scheduled missions, the rule check, reading a PDF, cheap mode chat
AREAO1_MODEL_MID=gpt-6.1-sol
# mundane: chat-history extraction, summarizing long chats, mail sorting
AREAO1_MODEL_MUNDANE=gpt-6-luna

# OpenAI: an API key is needed for chat and web lookups. Add it in Settings > Your AI (kept in the OS keychain),
# or set it here.
# OPENAI_API_KEY=sk-...
