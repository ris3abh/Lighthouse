# Lighthouse model tiers (ADR 0009). Copy to your workspace as .env (it's gitignored there) or set these in
# your environment. Everything is optional: without them Lighthouse uses the defaults shown.

# hard: chat, tasks you start, anything written for the petition
LIGHTHOUSE_MODEL_HARD=claude-opus-5-5
# mid: scheduled missions, the rule check, reading a PDF, cheap mode chat
LIGHTHOUSE_MODEL_MID=claude-sonnet-5-5
# mundane: chat-history extraction, summarizing long chats. With OPENAI_API_KEY set this is an OpenAI model
# (default gpt-5-mini); without it, Claude Haiku.
LIGHTHOUSE_MODEL_MUNDANE=claude-haiku-4-5-20251001
# OPENAI_API_KEY=sk-...

# Anthropic: the Claude Code login on this computer is used by default. To use an API key instead, add it in
# Settings > Your AI (kept in the OS keychain), or set ANTHROPIC_API_KEY here.
