{
  "$id": "https://areao1.dev/schemas/v1/memory-edge.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dst": {
      "title": "Dst",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "src": {
      "title": "Src",
      "type": "string"
    },
    "type": {
      "enum": [
        "DERIVED_FROM",
        "ABOUT",
        "SUPPORTS",
        "CONTRADICTS",
        "SUPERSEDES",
        "REVIEWED_BY",
        "CITES"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "src",
    "dst"
  ],
  "title": "Edge",
  "type": "object"
}
