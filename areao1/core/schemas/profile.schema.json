{
  "$defs": {
    "CriterionRule": {
      "additionalProperties": false,
      "properties": {
        "min_exhibits": {
          "default": 1,
          "description": "Accepted exhibits needed to bank the criterion.",
          "minimum": 1,
          "title": "Min Exhibits",
          "type": "integer"
        },
        "min_signals": {
          "default": 0,
          "description": "Distinct strength signals needed to bank it.",
          "minimum": 0,
          "title": "Min Signals",
          "type": "integer"
        }
      },
      "title": "CriterionRule",
      "type": "object"
    },
    "FinalMeritsRules": {
      "additionalProperties": false,
      "properties": {
        "framing": {
          "default": "",
          "title": "Framing",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "standard": {
          "items": {
            "$ref": "#/$defs/MeritsCitation"
          },
          "title": "Standard",
          "type": "array"
        },
        "themes": {
          "items": {
            "$ref": "#/$defs/MeritsTheme"
          },
          "title": "Themes",
          "type": "array"
        }
      },
      "required": [
        "label"
      ],
      "title": "FinalMeritsRules",
      "type": "object"
    },
    "MeritsCitation": {
      "additionalProperties": false,
      "description": "A passage of the standard, quoted word for word from a vault source, with where it is in that source.",
      "properties": {
        "quote": {
          "description": "A whole sentence, exactly as the source has it.",
          "title": "Quote",
          "type": "string"
        },
        "section": {
          "default": "",
          "description": "Where in the source, e.g. \"USCIS Policy Manual, Vol. 6, Part F, Ch. 2, Sec. B\".",
          "title": "Section",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "text": {
          "default": "",
          "description": "Optional plain-language lead shown before the quote.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "quote",
        "source_id"
      ],
      "title": "MeritsCitation",
      "type": "object"
    },
    "MeritsTheme": {
      "additionalProperties": false,
      "description": "One theme of the final-merits view (ADR 0019) and the visible rule that sets its status.",
      "properties": {
        "building": {
          "default": 1,
          "description": "The count at which it is building.",
          "minimum": 1,
          "title": "Building",
          "type": "integer"
        },
        "criteria": {
          "description": "Criteria whose exhibits count for this theme.",
          "items": {
            "type": "string"
          },
          "title": "Criteria",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "evidence_types": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Types",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "rule": {
          "enum": [
            "independent_letters",
            "outside_employer",
            "years",
            "peer_context",
            "adoption"
          ],
          "title": "Rule",
          "type": "string"
        },
        "signals": {
          "description": "Strength signals that count for this theme.",
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        },
        "strong": {
          "default": 1,
          "description": "The count at which the theme is strong.",
          "minimum": 1,
          "title": "Strong",
          "type": "integer"
        },
        "strong_share": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "independent_letters: share of writers too.",
          "title": "Strong Share"
        }
      },
      "required": [
        "id",
        "label",
        "rule"
      ],
      "title": "MeritsTheme",
      "type": "object"
    },
    "NarrativeLayer": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "prompts": {
          "items": {
            "type": "string"
          },
          "title": "Prompts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "NarrativeLayer",
      "type": "object"
    },
    "ProfileCriterion": {
      "additionalProperties": false,
      "properties": {
        "bank": {
          "$ref": "#/$defs/CriterionRule"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "evidence_types": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
            "type": "string"
          },
          "title": "Evidence Types",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "regulation": {
          "default": "",
          "title": "Regulation",
          "type": "string"
        },
        "short_label": {
          "default": "",
          "description": "One or two words for tight places (\"Awards\"); falls back to label.",
          "title": "Short Label",
          "type": "string"
        },
        "strength_signals": {
          "items": {
            "$ref": "#/$defs/StrengthSignal"
          },
          "title": "Strength Signals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "evidence_types"
      ],
      "title": "ProfileCriterion",
      "type": "object"
    },
    "StrengthSignal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "StrengthSignal",
      "type": "object"
    }
  },
  "$id": "https://areao1.dev/schemas/v1/profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "items": {
        "$ref": "#/$defs/ProfileCriterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "final_merits": {
      "anyOf": [
        {
          "$ref": "#/$defs/FinalMeritsRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The final-merits view's themes and rules."
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "narrative": {
      "description": "Qualitative layers scored by the agent, e.g. EB-1A final merits.",
      "items": {
        "$ref": "#/$defs/NarrativeLayer"
      },
      "title": "Narrative",
      "type": "array"
    },
    "regulation": {
      "default": "",
      "title": "Regulation",
      "type": "string"
    },
    "target": {
      "minimum": 1,
      "title": "Target",
      "type": "integer"
    },
    "threshold": {
      "minimum": 1,
      "title": "Threshold",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "threshold",
    "target",
    "criteria"
  ],
  "title": "Profile",
  "type": "object"
}
