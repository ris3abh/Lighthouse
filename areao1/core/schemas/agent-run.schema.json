{
  "$defs": {
    "RuleCheck": {
      "additionalProperties": false,
      "description": "Rule claims found in a piece of agent-written text and how each was verified (SPEC 5a).",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/RuleClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why nothing was checked, or why checking failed.",
          "title": "Note"
        }
      },
      "title": "RuleCheck",
      "type": "object"
    },
    "RuleCitation": {
      "additionalProperties": false,
      "description": "A knowledge-store excerpt a rule claim was checked against, with the exact words quoted from it.",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "fresh": {
          "default": true,
          "title": "Fresh",
          "type": "boolean"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "secondary_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for a secondary copy: the primary source's id. The primary governs.",
          "title": "Secondary To"
        },
        "sha256": {
          "description": "The snapshot the quote is from.",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Offset of the quote in the source snapshot.",
          "title": "Start",
          "type": "integer"
        },
        "tier": {
          "title": "Tier",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "entails",
            "contradicts"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "source_id",
        "title",
        "tier",
        "url",
        "quote",
        "start",
        "end",
        "sha256",
        "checked_at",
        "verdict"
      ],
      "title": "RuleCitation",
      "type": "object"
    },
    "RuleClaim": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/RuleCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "end": {
          "default": 0,
          "title": "End",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "sentence": {
          "description": "The sentence it came from.",
          "title": "Sentence",
          "type": "string"
        },
        "start": {
          "default": 0,
          "description": "Offset of the sentence in the checked text.",
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "enum": [
            "verified",
            "unverified",
            "stale",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "description": "The rule as the checker restated it.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "sentence",
        "status"
      ],
      "title": "RuleClaim",
      "type": "object"
    },
    "RunSource": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "observation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "RunSource",
      "type": "object"
    },
    "RunUsage": {
      "additionalProperties": false,
      "properties": {
        "cache_creation_input_tokens": {
          "default": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "default": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "RunUsage",
      "type": "object"
    },
    "TimelineItem": {
      "additionalProperties": false,
      "description": "One step of a run, in order: assistant text, a tool call and its result, or an error.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ok"
        },
        "result": {
          "default": "",
          "description": "Short summary of the tool result (full results aren't kept).",
          "title": "Result",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "tool_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Id"
        },
        "type": {
          "enum": [
            "text",
            "tool_call",
            "error"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "TimelineItem",
      "type": "object"
    }
  },
  "$id": "https://areao1.dev/schemas/v1/agent-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "description": "data/changes.jsonl ids this run made.",
      "items": {
        "type": "string"
      },
      "title": "Changes",
      "type": "array"
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "chat",
        "manual",
        "scheduled"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mission": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For scheduled runs: which mission.",
      "title": "Mission"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "proposals": {
      "description": "Inbox candidate ids this run proposed.",
      "items": {
        "type": "string"
      },
      "title": "Proposals",
      "type": "array"
    },
    "provider": {
      "anyOf": [
        {
          "enum": [
            "anthropic",
            "openai"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "rule_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rule claims in the final answer, checked."
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "search_cost_usd": {
      "default": 0.0,
      "description": "What they cost (per-search fee + tokens), part of cost_usd.",
      "title": "Search Cost Usd",
      "type": "number"
    },
    "searches": {
      "default": 0,
      "description": "Web searches that ran in this run.",
      "title": "Searches",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/RunSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "default": "running",
      "enum": [
        "running",
        "done",
        "error",
        "stopped"
      ],
      "title": "Status",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the run was for (ADR 0009 routing), e.g. chat, chat_extract.",
      "title": "Task"
    },
    "text": {
      "default": "",
      "description": "The assistant's final answer.",
      "title": "Text",
      "type": "string"
    },
    "tier": {
      "anyOf": [
        {
          "enum": [
            "hard",
            "mid",
            "mundane"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineItem"
      },
      "title": "Timeline",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/RunUsage"
    }
  },
  "required": [
    "kind",
    "engine",
    "model",
    "prompt"
  ],
  "title": "AgentRun",
  "type": "object"
}
