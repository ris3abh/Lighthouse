{
  "$defs": {
    "BriefingTodo": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An Inbox item this action approves or dismisses.",
          "title": "Candidate Id"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An in-app route (#/pipeline) or a URL.",
          "title": "Link"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "why": {
          "default": "",
          "maxLength": 400,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "BriefingTodo",
      "type": "object"
    },
    "RuleCheck": {
      "additionalProperties": false,
      "description": "Rule claims found in a piece of agent-written text and how each was verified (SPEC 5a).",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/RuleClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why nothing was checked, or why checking failed.",
          "title": "Note"
        }
      },
      "title": "RuleCheck",
      "type": "object"
    },
    "RuleCitation": {
      "additionalProperties": false,
      "description": "A knowledge-store excerpt a rule claim was checked against, with the exact words quoted from it.",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "fresh": {
          "default": true,
          "title": "Fresh",
          "type": "boolean"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "secondary_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for a secondary copy: the primary source's id. The primary governs.",
          "title": "Secondary To"
        },
        "sha256": {
          "description": "The snapshot the quote is from.",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "start": {
          "description": "Offset of the quote in the source snapshot.",
          "title": "Start",
          "type": "integer"
        },
        "tier": {
          "title": "Tier",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "entails",
            "contradicts"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "source_id",
        "title",
        "tier",
        "url",
        "quote",
        "start",
        "end",
        "sha256",
        "checked_at",
        "verdict"
      ],
      "title": "RuleCitation",
      "type": "object"
    },
    "RuleClaim": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/RuleCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "end": {
          "default": 0,
          "title": "End",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "sentence": {
          "description": "The sentence it came from.",
          "title": "Sentence",
          "type": "string"
        },
        "start": {
          "default": 0,
          "description": "Offset of the sentence in the checked text.",
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "enum": [
            "verified",
            "unverified",
            "stale",
            "conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "description": "The rule as the checker restated it.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "sentence",
        "status"
      ],
      "title": "RuleClaim",
      "type": "object"
    }
  },
  "$id": "https://areao1.dev/schemas/v1/briefing.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The agent-written Overview briefing, refreshed by the daily what-changed mission.",
  "properties": {
    "changed": {
      "description": "What changed, one line each.",
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Changed",
      "type": "array"
    },
    "generated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "rule_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "since": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Since"
    },
    "todos": {
      "description": "Three things this week.",
      "items": {
        "$ref": "#/$defs/BriefingTodo"
      },
      "maxItems": 3,
      "title": "Todos",
      "type": "array"
    }
  },
  "title": "Briefing",
  "type": "object"
}
