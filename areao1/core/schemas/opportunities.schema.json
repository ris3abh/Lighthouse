{
  "$defs": {
    "Opportunity": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "title": "Criterion",
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "fit_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fit Score",
          "type": "number"
        },
        "found_at": {
          "format": "date-time",
          "title": "Found At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "scan": {
          "title": "Scan",
          "type": "string"
        },
        "status": {
          "default": "new",
          "enum": [
            "new",
            "added",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "title",
        "criterion",
        "scan"
      ],
      "title": "Opportunity",
      "type": "object"
    }
  },
  "$id": "https://areao1.dev/schemas/v1/opportunities.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "opportunities": {
      "items": {
        "$ref": "#/$defs/Opportunity"
      },
      "title": "Opportunities",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "Opportunities",
  "type": "object"
}
